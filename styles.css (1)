/* ============================================================
   KYRO FINAL CHAT VISUAL REPAIR
   - User: translucent dark message card
   - AI: clean, borderless ChatGPT-like response
   - Typography: premium system/UI stack
   - Markdown: stronger hierarchy and readability
   ============================================================ */
#app,
#app button,
#app input,
#app textarea,
#app select,
#app .bubble,
#app .kyro-md{
  font-family: Inter, "SF Pro Display", "SF Pro Text", -apple-system,
               BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

#app #chat-view{
  padding: 12px 14px 20px !important;
  gap: 18px !important;
}

/* AI message: no surrounding box */
#app #chat-view .msg-row.ai{
  width: 100% !important;
  justify-content: flex-start !important;
}
#app #chat-view .msg-row.ai .msg-col{
  width: 100% !important;
  max-width: 100% !important;
  align-items: flex-start !important;
}
#app #chat-view .msg-row.ai .bubble{
  width: 100% !important;
  max-width: 100% !important;
  padding: 1px 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  border-radius: 0 !important;
  color: var(--text) !important;
  text-align: left !important;
  font-size: 16px !important;
  line-height: 1.64 !important;
  letter-spacing: .003em !important;
  font-weight: 450 !important;
}

/* User message: compact theme-aware glass bubble.
   The bubble hugs the message instead of stretching to a fixed width.
   Its height grows naturally only when the text wraps. */
#app #chat-view .msg-row.user{
  width: 100% !important;
  justify-content: flex-end !important;
  padding: 0 !important;
  margin: 0 !important;
}
#app #chat-view .msg-row.user .msg-col{
  width: fit-content !important;
  max-width: min(82%, 640px) !important;
  align-items: flex-end !important;
  min-width: 0 !important;
}
#app #chat-view .msg-row.user .bubble{
  display: block !important;
  width: fit-content !important;
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
  padding: 8px 13px !important;
  margin: 0 !important;
  border-radius: 18px 18px 5px 18px !important;
  background: color-mix(in srgb, var(--surface-2) 72%, transparent) !important;
  border: 1px solid color-mix(in srgb, var(--border) 82%, transparent) !important;
  box-shadow:
    0 7px 22px rgba(0,0,0,.16),
    inset 0 0 0 1px rgba(255,255,255,.025) !important;
  color: var(--text) !important;
  text-align: left !important;
  font-size: 16px !important;
  line-height: 1.50 !important;
  font-weight: 520 !important;
  letter-spacing: .002em !important;
  overflow-wrap: anywhere !important;
  backdrop-filter: blur(16px) saturate(125%) !important;
  -webkit-backdrop-filter: blur(16px) saturate(125%) !important;
}

/* No decorative blue/red line underneath user messages. */
#app #chat-view .msg-row.user .bubble::after{
  content: none !important;
}

/* AI Markdown typography */
#app .kyro-md{
  font-size: 16px !important;
  line-height: 1.64 !important;
  color: var(--text) !important;
  font-weight: 450 !important;
}
#app .kyro-md p{
  margin: 0 0 13px !important;
}
#app .kyro-md strong{
  font-weight: 700 !important;
  color: var(--text) !important;
}
#app .kyro-md h1,
#app .kyro-md h2,
#app .kyro-md h3,
#app .kyro-md h4{
  font-weight: 720 !important;
  letter-spacing: -.018em !important;
  line-height: 1.28 !important;
  margin: 20px 0 9px !important;
}
#app .kyro-md h1{font-size:1.48em !important;}
#app .kyro-md h2{font-size:1.30em !important;}
#app .kyro-md h3{font-size:1.14em !important;}
#app .kyro-md ul,
#app .kyro-md ol{
  padding-left: 24px !important;
  margin: 8px 0 15px !important;
}
#app .kyro-md li{
  margin: 5px 0 !important;
  padding-left: 2px !important;
}
#app .kyro-md blockquote{
  margin: 12px 0 !important;
  padding: 5px 0 5px 14px !important;
  border-left: 3px solid var(--accent) !important;
  color: var(--text-dim) !important;
}
#app .kyro-md code{
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
  font-size: .88em !important;
  background: rgba(127,127,127,.13) !important;
  border: 1px solid var(--border) !important;
  border-radius: 7px !important;
  padding: 2px 6px !important;
}
#app .kyro-md pre{
  border-radius: 14px !important;
  padding: 14px !important;
  margin: 13px 0 16px !important;
}

/* Streaming cursor */
#app .bubble.is-streaming::after{
  content:"";
  display:inline-block;
  width:2px;
  height:1.05em;
  margin-left:4px;
  vertical-align:-.16em;
  background:var(--accent);
  opacity:.78;
  animation:kyroFinalCaret .85s steps(1,end) infinite;
}
@keyframes kyroFinalCaret{
  0%,48%{opacity:.8}
  49%,100%{opacity:0}
}

/* Generated image card */
#app .kyro-generated-image{
  margin-top: 4px !important;
  max-width: min(88vw, 560px) !important;
}
#app .kyro-generated-image img{
  display:block !important;
  width:100% !important;
  height:auto !important;
  border-radius:18px !important;
  border:1px solid var(--border) !important;
  box-shadow:0 12px 34px rgba(0,0,0,.24) !important;
}

/* Mobile */
@media(max-width:520px){
  #app #chat-view{
    padding: 10px 13px 18px !important;
    gap: 16px !important;
  }
  #app #chat-view .msg-row.user .msg-col{
    max-width: 88% !important;
  }
  #app #chat-view .msg-row.ai .bubble,
  #app .kyro-md{
    font-size: 15.7px !important;
    line-height: 1.62 !important;
    font-weight: 450 !important;
  }
  #app #chat-view .msg-row.user .bubble{
    font-size: 15.7px !important;
    padding: 8px 12px !important;
    font-weight: 520 !important;
  }
}

/* Keep the first conversation turn comfortably below the top chrome. */
#app #chat-view{
  padding-top: 22px !important;
  scroll-padding-top: 22px !important;
}

/* User bubbles must hug the actual text width; never stretch just because the row is wide. */
#app #chat-view .msg-row.user .msg-col{
  display: flex !important;
  width: 100% !important;
  max-width: 100% !important;
  align-items: flex-end !important;
}
#app #chat-view .msg-row.user .bubble{
  display: inline-block !important;
  width: max-content !important;
  max-width: min(78vw, 620px) !important;
  min-width: 0 !important;
  flex: 0 1 auto !important;
  box-sizing: border-box !important;
  white-space: pre-wrap !important;
  overflow-wrap: anywhere !important;
  word-break: normal !important;
}

/* One short line = short bubble. Longer text grows only as much as wrapping requires. */
@media (max-width: 700px){
  #app #chat-view .msg-row.user .bubble{
    max-width: 78vw !important;
  }
}

/* ChatGPT-style explicit send button stays the only send action. */
#app #composer textarea{
  white-space: pre-wrap !important;
}

/* Top controls stay crisp. The chat area gets a subtle frosted layer beneath them
   only while a conversation is actually visible. */
#app{
  --kyro-topbar-height: 72px;
}
#app #chat-view{
  position: relative !important;
  z-index: 1 !important;
}
#app #chat-view::before{
  content:"";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 92px;
  pointer-events: none;
  z-index: -1;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,.18),
    rgba(0,0,0,.07) 58%,
    transparent
  );
  backdrop-filter: blur(8px) saturate(112%);
  -webkit-backdrop-filter: blur(8px) saturate(112%);
  opacity: 0;
  transition: opacity .22s ease;
}
/* Only activate the blur when there is a rendered chat message. */
#app #chat-view:has(.msg-row, .message, .chat-message, [data-message]){
  /* The chat itself remains readable; the frosted background sits behind it. */
}
#app #chat-view:has(.msg-row, .message, .chat-message, [data-message])::before{
  opacity: 1;
}

/* Keep the top control strip above the frosted chat layer. */
#app header,
#app .topbar,
#app .header,
#app .app-header,
#app .model-bar,
#app .chat-header{
  position: relative !important;
  z-index: 20 !important;
