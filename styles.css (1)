/* ============================================================
   KYRO — design tokens
   ============================================================ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
:root{
  --radius-s:10px; --radius-m:16px; --radius-l:22px; --radius-xl:28px; --radius-round:999px;
  --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:20px; --sp-6:24px; --sp-7:32px;
  --ease:cubic-bezier(.22,1,.36,1);
  --dur-fast:.18s; --dur-med:.32s; --dur-slow:.6s;
  --font: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --safe-top:env(safe-area-inset-top,0px);
  --safe-bottom:env(safe-area-inset-bottom,0px);
  --logo-img:url("data:image/png;base64,");
}
/* ---- Theme palettes ---- */
[data-theme="dark"]{
  --bg:#05080a; --bg-elev:#0a1013; --surface:rgba(255,255,255,.045); --surface-2:rgba(255,255,255,.08);
  --border:rgba(255,255,255,.09); --text:#eef4f5; --text-dim:#93a6a9; --text-faint:#5c6e70;
  --accent:#2fd8e0; --accent-2:#18b4c0; --accent-glow:rgba(47,216,224,.5);
  --danger:#f16565; --success:#3ecf94; --warn:#f0b34c;
  --sheen:rgba(255,255,255,.06);
}
[data-theme="jetblack"]{
  --bg:#000000; --bg-elev:#050505; --surface:rgba(255,255,255,.035); --surface-2:rgba(255,255,255,.07);
  --border:rgba(255,255,255,.10); --text:#ffffff; --text-dim:#b8b8b8; --text-faint:#707070;
  --accent:#ffffff; --accent-2:#d8d8d8; --accent-glow:rgba(255,255,255,.22);
  --danger:#ff5f5f; --success:#58d68d; --warn:#f1c75b;
  --sheen:rgba(255,255,255,.045);
}

[data-theme="pureblack"]{
  --bg:#000000; --bg-elev:#000000; --surface:#111111; --surface-2:#181818;
  --border:#2a2a2a; --text:#ffffff; --text-dim:#bdbdbd; --text-faint:#777777;
  --accent:#ffffff; --accent-2:#e0e0e0; --accent-glow:transparent;
  --danger:#ff5f5f; --success:#58d68d; --warn:#f1c75b; --sheen:rgba(255,255,255,.04);
}
[data-theme="light"]{
  --bg:#f3f6f7; --bg-elev:#ffffff; --surface:rgba(6,20,24,.035); --surface-2:rgba(6,20,24,.065);
  --border:rgba(6,20,24,.1); --text:#0b1517; --text-dim:#54696c; --text-faint:#8b9ea0;
  --accent:#0a94a6; --accent-2:#077586; --accent-glow:rgba(10,148,166,.28);
  --danger:#c53838; --success:#188a5f; --warn:#a86a10;
  --sheen:rgba(6,20,24,.04);
}
[data-theme="midnight"]{
  --bg:#04050d; --bg-elev:#090b1a; --surface:rgba(140,150,255,.05); --surface-2:rgba(140,150,255,.095);
  --border:rgba(150,160,255,.13); --text:#edeeff; --text-dim:#9ea1cf; --text-faint:#5f6291;
  --accent:#7c8cff; --accent-2:#5f6ef0; --accent-glow:rgba(124,140,255,.5);
  --danger:#ff6b81; --success:#4fd9a8; --warn:#f0b34c;
  --sheen:rgba(180,190,255,.07);
}
[data-theme="ocean"]{
  --bg:#03121a; --bg-elev:#062131; --surface:rgba(90,200,255,.05); --surface-2:rgba(90,200,255,.095);
  --border:rgba(110,205,255,.15); --text:#eafcff; --text-dim:#87b4c2; --text-faint:#4f7580;
  --accent:#22b8f5; --accent-2:#1494c9; --accent-glow:rgba(34,184,245,.5);
  --danger:#ff6b6b; --success:#3ed6a8; --warn:#f0b34c;
  --sheen:rgba(120,210,255,.07);
}
[data-theme="emerald"]{
  --bg:#031611; --bg-elev:#062820; --surface:rgba(70,230,170,.05); --surface-2:rgba(70,230,170,.095);
  --border:rgba(90,225,175,.15); --text:#eafff5; --text-dim:#83c1a6; --text-faint:#4b7864;
  --accent:#28d38a; --accent-2:#1cae70; --accent-glow:rgba(40,211,138,.5);
  --danger:#ff6b6b; --success:#5be3a8; --warn:#f0c24c;
  --sheen:rgba(110,235,180,.07);
}
[data-theme="purple"]{
  --bg:#0b0616; --bg-elev:#160c28; --surface:rgba(170,120,255,.055); --surface-2:rgba(170,120,255,.1);
  --border:rgba(180,135,255,.16); --text:#f5f0ff; --text-dim:#b3a0d6; --text-faint:#6c5c8c;
  --accent:#a670ff; --accent-2:#8a4df0; --accent-glow:rgba(166,112,255,.5);
  --danger:#ff6f8f; --success:#4fd9a8; --warn:#f0b34c;
  --sheen:rgba(200,170,255,.08);
}
[data-theme="sunset"]{
  --bg:#160907; --bg-elev:#28110b; --surface:rgba(255,140,95,.055); --surface-2:rgba(255,140,95,.1);
  --border:rgba(255,150,110,.17); --text:#fff3ee; --text-dim:#d3a290; --text-faint:#8a5c4c;
  --accent:#ff8a5c; --accent-2:#ff6a3d; --accent-glow:rgba(255,138,92,.5);
  --danger:#ff5c5c; --success:#4fd9a8; --warn:#ffcf5c;
  --sheen:rgba(255,180,150,.08);
}

html,body{height:100%;}
body{
  font-family:var(--font); background:var(--bg); color:var(--text);
  overflow:hidden; position:fixed; inset:0; width:100%;
  -webkit-font-smoothing:antialiased; transition:background var(--dur-med) var(--ease), color var(--dur-med) var(--ease);
  font-size:15px; line-height:1.5;
}
[hidden]{display:none !important;}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;}
input,textarea{font:inherit;color:inherit;background:none;border:none;outline:none;}
::selection{background:var(--accent-glow);color:var(--text);}
a{color:var(--accent);}

/* scrollbars */
*{scrollbar-width:thin;scrollbar-color:var(--border) transparent;}
*::-webkit-scrollbar{width:6px;height:6px;}
*::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px;}
*::-webkit-scrollbar-track{background:transparent;}

.icon{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;display:block;}
.icon-sm{width:16px;height:16px;}
.icon-lg{width:26px;height:26px;}

/* ============================================================
   Ambient animated background (shared across all screens)
   ============================================================ */
#bg-fx{position:fixed;inset:0;z-index:0;overflow:hidden;background:var(--bg);transition:background var(--dur-med) var(--ease);}
.blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.55;will-change:transform;}
.blob-a{width:60vw;height:60vw;left:-20vw;top:-10vh;background:radial-gradient(circle,var(--accent-glow),transparent 70%);animation:blobA 22s ease-in-out infinite alternate;}
.blob-b{width:50vw;height:50vw;right:-15vw;top:30vh;background:radial-gradient(circle,var(--accent-2),transparent 70%);opacity:.28;animation:blobB 26s ease-in-out infinite alternate;}
.blob-c{width:45vw;height:45vw;left:5vw;bottom:-15vh;background:radial-gradient(circle,var(--accent-glow),transparent 70%);opacity:.3;animation:blobC 19s ease-in-out infinite alternate;}
@keyframes blobA{from{transform:translate(0,0) scale(1)}to{transform:translate(6vw,8vh) scale(1.12)}}
@keyframes blobB{from{transform:translate(0,0) scale(1)}to{transform:translate(-8vw,-6vh) scale(.9)}}
@keyframes blobC{from{transform:translate(0,0) scale(1)}to{transform:translate(4vw,-8vh) scale(1.08)}}
#bg-canvas{position:absolute;inset:0;width:100%;height:100%;opacity:.55;}
.bg-grain{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,transparent 40%,var(--bg) 95%);}

/* ============================================================
   Splash — Realme-style boot sequence
   ============================================================ */
#splash{
  position:fixed;inset:0;z-index:100;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:10px;background:var(--bg);overflow:hidden;
  transition:opacity .65s var(--ease);
}
#splash.leaving{opacity:0;pointer-events:none;}
#splash .logo-wrap{
  position:relative;width:140px;height:190px;
  display:flex;align-items:center;justify-content:center;
  margin-top:-10px;
}
#splash .logo-glow{display:none!important;}
#splash /* ============================================================
   Splash + Global Logo Motion
   ============================================================ */
.logo-mark{
  position:relative;z-index:2;width:42px;height:42px;
  background-image:var(--logo-img);background-size:contain;
  background-position:center;background-repeat:no-repeat;
  transform-origin:center center;
  animation:logoSpin 2.8s linear infinite,logoColor 7.5s linear infinite;
  will-change:transform,filter;
}
.logo-mark.static{animation:logoSpin 2.8s linear infinite,logoColor 7.5s linear infinite;}
@keyframes logoSpin{to{transform:rotate(360deg)}}
@keyframes logoColor{
  0%{filter:hue-rotate(0deg) saturate(1.25) brightness(1.04) drop-shadow(0 0 10px rgba(0,255,130,.22))}
  12.5%{filter:hue-rotate(45deg) saturate(1.35) brightness(1.06) drop-shadow(0 0 12px rgba(0,220,255,.24))}
  25%{filter:hue-rotate(90deg) saturate(1.4) brightness(1.07) drop-shadow(0 0 13px rgba(70,120,255,.25))}
  37.5%{filter:hue-rotate(135deg) saturate(1.4) brightness(1.07) drop-shadow(0 0 14px rgba(170,80,255,.24))}
  50%{filter:hue-rotate(180deg) saturate(1.4) brightness(1.08) drop-shadow(0 0 14px rgba(255,70,190,.24))}
  62.5%{filter:hue-rotate(225deg) saturate(1.35) brightness(1.07) drop-shadow(0 0 13px rgba(255,70,90,.22))}
  75%{filter:hue-rotate(270deg) saturate(1.3) brightness(1.08) drop-shadow(0 0 13px rgba(255,180,45,.22))}
  87.5%{filter:grayscale(1) brightness(1.9) contrast(.92) drop-shadow(0 0 14px rgba(255,255,255,.25))}
  100%{filter:hue-rotate(360deg) saturate(1.25) brightness(1.04) drop-shadow(0 0 10px rgba(0,255,130,.22))}
}
#splash{
  position:fixed;inset:0;z-index:100;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:10px;background:var(--bg);overflow:hidden;
  transition:opacity .65s var(--ease);
}
#splash.leaving{opacity:0;pointer-events:none}
#splash .logo-wrap{position:relative;width:140px;height:190px;display:flex;align-items:center;justify-content:center;margin-top:-10px}
#splash .logo-glow{display:none!important}
#splash .logo-mark{
  width:148px;height:148px;
  animation:splashBootLogo 2.9s cubic-bezier(.16,.8,.18,1) both,logoColor 7.5s linear infinite;
}
@keyframes splashBootLogo{
  0%{opacity:0;transform:translateY(105px) scale(.18) rotate(-100deg);filter:brightness(1.5) drop-shadow(0 0 24px rgba(255,255,255,.75))}
  16%{opacity:1;transform:translateY(65px) scale(.32) rotate(55deg);filter:brightness(1.65) drop-shadow(0 0 30px rgba(255,255,255,.75))}
  42%{opacity:1;transform:translateY(15px) scale(.58) rotate(220deg);filter:brightness(1.25) drop-shadow(0 0 22px rgba(0,220,255,.5))}
  72%{opacity:1;transform:translateY(0) scale(.88) rotate(500deg);filter:brightness(1.12) drop-shadow(0 0 18px rgba(0,255,150,.42))}
  100%{opacity:1;transform:translateY(0) scale(1) rotate(720deg);filter:brightness(1.05) drop-shadow(0 0 16px rgba(0,255,150,.30))}
}
#splash .splash-word{position:relative;font-size:40px;font-weight:800;letter-spacing:11px;padding-left:11px;line-height:1;opacity:0;animation:splashWord 2.9s ease-out both}
@keyframes splashWord{
  0%,18%{opacity:0;filter:brightness(2);text-shadow:0 0 34px rgba(255,255,255,.95)}
  32%{opacity:1;filter:brightness(2.1);text-shadow:0 0 28px rgba(255,255,255,.85)}
  48%{opacity:1;filter:brightness(1.5);text-shadow:0 0 12px rgba(255,255,255,.45)}
  62%,100%{opacity:1;filter:brightness(1);text-shadow:none}
}
#splash .splash-tag{font-size:9px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;font-weight:600;opacity:0;animation:splashPowered 2.9s ease-out both}
@keyframes splashPowered{
  0%,45%{opacity:0;transform:translateY(5px)}
  60%{opacity:.35;transform:translateY(2px)}
  78%,100%{opacity:.72;transform:translateY(0)}
}
#splash .splash-bar{display:none!important}
@media (prefers-reduced-motion:reduce){
  #splash .logo-mark,.logo-mark,.splash-word,.splash-tag{animation:none!important;opacity:1}
}

/* ============================================================
   Onboarding (local profile — first launch)
   ============================================================ */
#onboard{position:fixed;inset:0;z-index:90;display:flex;align-items:center;justify-content:center;padding:var(--sp-6);}
.card-glass{background:var(--surface);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border:1px solid var(--border);border-radius:var(--radius-xl);box-shadow:0 20px 60px rgba(0,0,0,.35);}
.onboard-card{width:100%;max-width:360px;padding:var(--sp-7) var(--sp-6);text-align:center;animation:slideUp var(--dur-slow) var(--ease);}
.onboard-card .logo-wrap{width:64px;height:64px;margin:0 auto var(--sp-4);}
.onboard-card .logo-mark{width:36px;height:36px;}
.onboard-card .logo-glow{inset:-16px;}
.onboard-card h1{font-size:20px;font-weight:700;margin-bottom:var(--sp-1);}
.onboard-card p{color:var(--text-dim);font-size:13.5px;margin-bottom:var(--sp-6);}
.field{display:flex;align-items:center;gap:var(--sp-3);background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-m);padding:14px var(--sp-4);margin-bottom:var(--sp-3);transition:border-color var(--dur-fast);}
.field:focus-within{border-color:var(--accent);}
.field .icon{color:var(--text-faint);}
.field input{flex:1;font-size:14.5px;}
.field input::placeholder{color:var(--text-faint);}
.btn-primary{width:100%;padding:15px;border-radius:var(--radius-m);background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#04141a;font-weight:700;font-size:15px;margin-top:var(--sp-2);box-shadow:0 8px 24px var(--accent-glow);transition:transform var(--dur-fast),box-shadow var(--dur-fast);}
.btn-primary:active{transform:scale(.97);}
.onboard-note{margin-top:var(--sp-4);font-size:11.5px;color:var(--text-faint);line-height:1.5;}

/* ============================================================
   App shell
   ============================================================ */
#app{position:fixed;inset:0;z-index:1;display:flex;}
#main{position:relative;flex:1;display:flex;flex-direction:column;min-width:0;height:100%;transition:transform var(--dur-med) var(--ease),filter var(--dur-med) var(--ease);}
#app.sidebar-open #main{transform:scale(.96) translateX(30%);filter:brightness(.6);}

/* topbar */
#topbar{display:flex;align-items:center;justify-content:flex-start;gap:6px;padding:calc(var(--safe-top) + 8px) 10px 8px;position:relative;z-index:3;}
.icon-btn{width:40px;height:40px;flex-shrink:0;border-radius:var(--radius-round);display:flex;align-items:center;justify-content:center;background:var(--surface);border:1px solid var(--border);color:var(--text);position:relative;overflow:hidden;transition:background var(--dur-fast),transform var(--dur-fast);}
.icon-btn:active{transform:scale(.9);}
.icon-btn.accent{color:var(--accent);}
.model-chip{display:flex;align-items:center;gap:4px;padding:5px 7px;border-radius:999px;background:transparent;border:0;font-size:10px;font-weight:600;max-width:92px;height:28px;flex:0 0 auto;}
.model-chip .dot{width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 7px var(--accent-glow);flex-shrink:0;}
.model-chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.model-chip .icon{width:11px;height:11px;}
#btn-profile{margin-left:auto;}
.avatar{width:40px;height:40px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--text);font-size:14px;flex-shrink:0;overflow:hidden;padding:0;}
.avatar img{width:100%;height:100%;object-fit:cover;display:block;}

/* home */
#home-view{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 var(--sp-6);text-align:center;overflow-y:auto;gap:var(--sp-6);}
.home-greeting h1{font-size:26px;font-weight:700;letter-spacing:-.3px;}
.home-greeting p{color:var(--text-dim);font-size:14px;margin-top:4px;}
.home-logo{width:150px;height:150px;position:relative;display:flex;align-items:center;justify-content:center;}
.home-logo .logo-mark{width:118px;height:118px;}
.quick-row{display:flex;gap:var(--sp-3);overflow-x:auto;touch-action:pan-x;-webkit-overflow-scrolling:touch;width:100%;padding:2px var(--sp-1) var(--sp-2);scrollbar-width:none;}
.quick-row::-webkit-scrollbar{display:none;}
.quick-tile{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 18px;border-radius:var(--radius-l);background:var(--surface);border:1px solid var(--border);min-width:78px;transition:transform var(--dur-fast),background var(--dur-fast);}
.quick-tile:active{transform:scale(.94);background:var(--surface-2);}
.quick-tile .icon{color:var(--accent);}
.quick-tile span{font-size:11.5px;color:var(--text-dim);font-weight:500;white-space:nowrap;}
.quick-tile[data-soon="1"]{opacity:.4;}

/* chat */
#chat-view{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:var(--sp-3) 8px var(--sp-4);display:flex;flex-direction:column;gap:12px;}
.msg-row{display:flex;align-items:flex-start;gap:8px;width:100%;max-width:100%;animation:slideUp var(--dur-med) var(--ease);}
.msg-row.user{flex-direction:row;justify-content:flex-end;}
.msg-avatar{width:38px;height:38px;border-radius:0;flex:0 0 38px;display:flex;align-items:center;justify-content:center;background:transparent!important;border:0!important;color:var(--accent);margin-top:2px;overflow:visible;}
.msg-avatar .logo-mark{width:38px;height:38px;background-color:transparent!important;border-radius:0!important;}
.msg-avatar.user-av{display:none!important;}
.msg-col{display:flex;flex-direction:column;gap:3px;min-width:0;max-width:calc(100% - 46px);}
.msg-row.user .msg-col{max-width:86%;align-items:flex-end;}
.bubble{padding:7px 10px;border-radius:14px;font-size:14px;line-height:1.4;white-space:pre-wrap;word-break:break-word;background:transparent!important;border:0!important;backdrop-filter:none!important;box-shadow:none!important;}
.msg-row.ai .bubble{color:var(--text);border-top-left-radius:3px;}
.msg-row.user .bubble{color:var(--text);border-top-right-radius:3px;font-weight:400;}
.msg-attach{max-width:180px;border-radius:var(--radius-m);overflow:hidden;border:1px solid var(--border);}
.msg-attach img{width:100%;display:block;}
.msg-meta{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--text-faint);padding:0 3px;}
.msg-actions{display:flex;gap:4px;opacity:.85;}
.msg-actions button{width:26px;height:26px;flex-shrink:0;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--text-faint);transition:background var(--dur-fast),color var(--dur-fast);}
.msg-actions button:active{background:var(--surface-2);color:var(--accent);}
.typing-dots{display:flex;gap:4px;padding:6px 2px;}
.typing-dots span{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pulseDot 1.3s infinite;}
.typing-dots span:nth-child(2){animation-delay:.18s;}
.typing-dots span:nth-child(3){animation-delay:.36s;}
@keyframes pulseDot{0%,80%,100%{opacity:.25;transform:scale(.75)}40%{opacity:1;transform:scale(1)}}
.status-row{display:flex;align-items:center;gap:8px;width:100%;font-size:12.5px;color:var(--text-dim);padding:2px 0;}
.status-logo{width:38px!important;height:38px!important;flex:0 0 38px;background-image:var(--logo-img)!important;background-color:transparent!important;background-size:contain!important;background-position:center!important;background-repeat:no-repeat!important;border-radius:0!important;animation:logoSpin 2.2s linear infinite,logoColor 5.8s linear infinite!important;}

/* composer */
#composer-wrap{padding:var(--sp-3) var(--sp-4) calc(var(--safe-bottom) + 12px);position:relative;z-index:3;}
#composer{display:flex;flex-direction:column;gap:0;background:var(--surface);border:1px solid var(--border);border-radius:26px;padding:7px;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 10px 30px rgba(0,0,0,.18);transition:min-height .18s ease,border-color .18s ease,box-shadow .18s ease;}
#composer.has-attachments{min-height:132px;box-shadow:0 12px 34px rgba(0,0,0,.22);}
.composer-attachments{display:block;padding:2px 2px 6px;}
.composer-attachments[hidden]{display:none;}
.attach-chips{display:flex;gap:8px;overflow-x:auto;touch-action:pan-x;-webkit-overflow-scrolling:touch;padding:0 0 2px;}
.attach-chip{position:relative;flex:0 0 auto;width:64px;height:64px;border-radius:14px;overflow:hidden;border:1px solid var(--border);background:var(--surface-2);}
.attach-chip img{width:100%;height:100%;object-fit:cover;}
