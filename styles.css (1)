/* Pure Black performance: disable backdrop-filter ONLY on elements that have it.
   NO universal selector — it causes massive recalculation on every interaction. */
html[data-theme="pureblack"] #app,
html[data-theme="pureblack"] #chat-view,
html[data-theme="pureblack"] .topbar,
html[data-theme="pureblack"] .kyro-topbar-blur,
html[data-theme="pureblack"] #sheet-profile,
html[data-theme="pureblack"] #sheet-backdrop,
html[data-theme="pureblack"] .modal,
html[data-theme="pureblack"] #modal-settings,
html[data-theme="pureblack"] #modal-about,
html[data-theme="pureblack"] #modal-help,
html[data-theme="pureblack"] #modal-model,
html[data-theme="pureblack"] .composer-bar,
html[data-theme="pureblack"] .sidebar,
html[data-theme="pureblack"] .kyro-top-image-btn,
html[data-theme="pureblack"] .card-glass,
html[data-theme="pureblack"] #composer,
html[data-theme="pureblack"] .kyro-chat-header,
html[data-theme="pureblack"] #kyro-chat-header,
html[data-theme="pureblack"] .settings-header,
html[data-theme="pureblack"] .kyro-profile-header,
html[data-theme="pureblack"] .kyro-work-mode-bar,
html[data-theme="pureblack"] .kyro-image-gen-modal,
html[data-theme="pureblack"] .kyro-share-sheet,
html[data-theme="pureblack"] .kyro-popup-menu,
html[data-theme="pureblack"] .kyro-context-menu,
html[data-theme="pureblack"] #kyro-image-viewer,
html[data-theme="pureblack"] .kyro-tasks-page,
html[data-theme="pureblack"] .kyro-library-page,
html[data-theme="pureblack"] .kyro-projects-page{
  backdrop-filter:none !important;
  -webkit-backdrop-filter:none !important;
}
/* Keep transitions on interactive elements */
html[data-theme="pureblack"] #sheet-profile,
html[data-theme="pureblack"] #sheet-backdrop,
html[data-theme="pureblack"] .modal,
html[data-theme="pureblack"] .sheet,
html[data-theme="pureblack"] .btn-primary,
